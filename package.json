{
  "name": "obsidian-checklink",
  "version": "1.0.0",
  "description": "Auto-sync checklists and tasks referencing note wikilinks with note completion properties (e.g. completed_date).",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "checklist",
    "tasks",
    "wikilink",
    "frontmatter",
    "properties",
    "sync",
    "backlinks"
  ],
  "author": {
    "name": "SSKhekhaliya",
    "url": "https://www.sskhekhaliya.in/"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.5.4"
  }
}

